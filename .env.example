# Copy values into your shell or deployment secret manager. No file is auto-loaded.
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=55432
DATABASE_URL=postgres://hedrion:replace-with-a-local-development-password@127.0.0.1:55432/hedrion?sslmode=disable
TEST_DATABASE_URL=postgres://hedrion:replace-with-a-local-development-password@127.0.0.1:55432/hedrion?sslmode=disable
API_BIND=127.0.0.1
API_PORT=8080
CORS_ORIGINS=http://localhost:8082,http://localhost:8083
SECURE_COOKIES=false
OBJECT_STORAGE_PATH=../../.local/objects
WORKER_URL=http://127.0.0.1:8091
WORKER_HOST=127.0.0.1
WORKER_PORT=8091
WORKER_SHARED_SECRET=replace-with-at-least-32-random-characters
GENERATION_PROVIDER=fake
ENABLE_EXPERIMENTAL_PROVIDER=false
API_ORIGIN=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8081
STUDIO_ORIGIN=http://localhost:8082
PORT=8081
HOST=127.0.0.1
# Local administrative provisioning only; never put these in Flutter defines.
MODERATOR_EMAIL=moderator@example.test
MODERATOR_PASSWORD=replace-with-12-or-more-characters
MODERATOR_NAME=Moderator
