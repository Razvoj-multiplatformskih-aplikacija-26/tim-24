# Local KT2 defaults: copy this file unchanged to .env, then docker compose up --build -d.
# These are public development credentials; replace them for a public deployment.
POSTGRES_PASSWORD=hedrion-local-development-only
POSTGRES_PORT=55432
DATABASE_URL=postgres://hedrion:hedrion-local-development-only@127.0.0.1:55432/hedrion?sslmode=disable
TEST_DATABASE_URL=postgres://hedrion:hedrion-local-development-only@127.0.0.1:55432/hedrion?sslmode=disable
API_BIND=127.0.0.1
API_PORT=8080
CORS_ORIGINS=http://localhost:8082,http://localhost:8083,http://localhost:19082,http://localhost:19083,http://127.0.0.1:19082,http://127.0.0.1:19083
SECURE_COOKIES=false
OBJECT_STORAGE_PATH=../../.local/objects
# Compose's internal worker address. Host-run API may use http://127.0.0.1:8091.
WORKER_URL=http://worker:8091
WORKER_HOST=127.0.0.1
WORKER_PORT=8091
WORKER_SHARED_SECRET=hedrion-local-worker-secret-at-least-32-characters
GENERATION_PROVIDER=fake
SEED_DEMO_DATA=true
DEMO_CREATOR_PASSWORD=HedrionCreator123!
DEMO_MODERATOR_PASSWORD=HedrionModerator123!
DEMO_ADMIN_PASSWORD=HedrionAdmin123!
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000
# Live Modal mode: GENERATION_PROVIDER=modal and WORKER_URL=<private gateway URL>.
# Enable a model only after its CPU preparation/access check succeeds.
ENABLED_GENERATION_MODELS=spar3d,hunyuan3d_21,trellis2
WORKER_TIMEOUT_SECONDS=2700
STUDIO_PORT=19082
BACKOFFICE_PORT=19083
ENABLE_EXPERIMENTAL_PROVIDER=false
API_ORIGIN=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8081
STUDIO_ORIGIN=http://localhost:8082
PORT=8081
HOST=127.0.0.1
# Local administrative provisioning only; never put these in Flutter defines.
MODERATOR_EMAIL=moderator@hedrion.test
MODERATOR_PASSWORD=HedrionModerator123!
MODERATOR_NAME=Moderator
